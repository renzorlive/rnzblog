---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import BlogCard from '../../components/BlogCard.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const categories = [...new Set(allPosts.map(post => post.data.category))];
  
  return categories.map(category => ({
    params: { category },
    props: { 
      posts: allPosts.filter(post => post.data.category === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    }
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;

// Category information
const categoryInfo = {
  programming: {
    title: 'Programming',
    description: 'Code tutorials, best practices, development insights, and programming tips.',
    icon: '💻'
  },
  automotive: {
    title: 'Automotive Technology',
    description: 'Car technology, reviews, automotive innovations, and industry insights.',
    icon: '🚗'
  },
  networking: {
    title: 'Networking',
    description: 'Network configurations, protocols, IT infrastructure, and connectivity solutions.',
    icon: '🌐'
  },
  tech: {
    title: 'Technology',
    description: 'Latest tech trends, gadgets, digital innovations, and technology reviews.',
    icon: '⚡'
  },
  family: {
    title: 'Family Life',
    description: 'Parenting tips, toddler experiences, family adventures, and life balance.',
    icon: '👨👩👧👦'
  }
};

const currentCategory = categoryInfo[category as keyof typeof categoryInfo];
---

<BaseLayout 
  title={`${currentCategory.title} Posts - RNZ Blog`}
  description={`${currentCategory.description} Browse ${posts.length} posts in the ${currentCategory.title.toLowerCase()} category.`}
>
  <Navigation />
  <ThemeToggle />
  <ReadingProgress />
  
  <main class="pt-24 mt-8 bg-gray-50 dark:bg-gray-900 min-h-screen transition-colors duration-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Category Header -->
      <div class="text-center mb-12">
        <div class="text-6xl mb-4">{currentCategory.icon}</div>
        <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">{currentCategory.title}</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-6">
          {currentCategory.description}
        </p>
        <div class="flex items-center justify-center gap-4 text-sm text-gray-500 dark:text-gray-400">
          <span>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
          <span>•</span>
          <a href="/blog" class="text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300">View all posts</a>
        </div>
      </div>

      <!-- Posts Grid -->
      {posts.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              heroImage={post.data.heroImage}
              category={post.data.category}
              tags={post.data.tags}
              slug={post.slug}
              featured={post.data.featured}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <div class="text-gray-400 dark:text-gray-600 text-6xl mb-4">📝</div>
          <h3 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2">No posts yet</h3>
          <p class="text-gray-500 dark:text-gray-400 mb-6">
            Posts in the {currentCategory.title.toLowerCase()} category are coming soon!
          </p>
          <a 
            href="/blog" 
            class="inline-flex items-center bg-primary-600 dark:bg-primary-500 text-white px-6 py-3 rounded-xl hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors"
          >
            Browse All Posts
          </a>
        </div>
      )}

      <!-- Other Categories -->
      <section class="mt-16 pt-12 border-t border-gray-200 dark:border-gray-700">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center">Explore Other Categories</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {Object.entries(categoryInfo)
            .filter(([key]) => key !== category)
            .map(([key, info]) => (
              <a 
                href={`/category/${key}`}
                class="bg-white/80 dark:bg-gray-800/90 backdrop-blur-sm rounded-2xl shadow-glass border border-white/20 dark:border-gray-600/30 p-6 text-center hover:shadow-glow hover:scale-105 transition-all duration-300"
              >
                <div class="text-3xl mb-2">{info.icon}</div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">{info.title}</h3>
                <p class="text-sm text-gray-600 dark:text-gray-300">{info.description.split('.')[0]}.</p>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</BaseLayout>