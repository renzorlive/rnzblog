---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import BlogCard from '../components/BlogCard.astro';
import LatestPost from '../components/LatestPost.astro';
import HeroCard from '../components/HeroCard.astro';
import DonationCard from '../components/DonationCard.astro';
import ProfileCard from '../components/ProfileCard.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import SearchModal from '../components/SearchModal.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import PWAInstall from '../components/PWAInstall.astro';
import TouchGestures from '../components/TouchGestures.astro';

// Get all blog posts and sort by date
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get featured posts and recent posts
const featuredPosts = sortedPosts.filter(post => post.data.featured).slice(0, 3);
const recentPosts = sortedPosts.slice(0, 6);

// Get posts by category for showcase
const categories = ['programming', 'automotive', 'networking', 'tech', 'family'];
const postsByCategory = categories.reduce((acc, category) => {
  acc[category] = sortedPosts.filter(post => post.data.category === category).slice(0, 2);
  return acc;
}, {} as Record<string, typeof sortedPosts>);
---

<BaseLayout 
  title="RNZ Blog - Programming, Tech, Cars & Family Life"
  description="Personal blog covering programming tutorials, automotive technology, networking guides, IT insights, and family life experiences with a 2-year-old."
>
  <Navigation />
  <ThemeToggle />
  <ReadingProgress />
  <SearchModal />
  <ScrollToTop />
  <PWAInstall />
  <TouchGestures />
  
  <main class="pt-24">
    <!-- Two-column layout section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Content -->
        <div class="flex-1">
          <!-- Latest Post Hero -->
          <LatestPost />
        </div>
        
        <!-- Sidebar -->
        <div class="lg:w-80 space-y-6">
          <ProfileCard />
          <HeroCard />
          <DonationCard />
        </div>
      </div>
    </div>

    <!-- Full-width content below sidebar -->
    <!-- Featured Posts -->
    {featuredPosts.length > 0 && (
      <section class="py-20 relative">
        <div class="absolute inset-0 bg-gradient-to-b from-white to-surface-50/50 dark:from-gray-900 dark:to-gray-800/50"></div>
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16 animate-slide-up">
            <h2 class="text-4xl md:text-5xl font-display font-bold text-gray-900 dark:text-gray-100 mb-4">Featured Posts</h2>
            <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">Handpicked articles covering the latest in tech, automotive, and family life</p>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {featuredPosts.map((post, index) => (
              <div class="animate-fade-in" style={`animation-delay: ${index * 0.2}s;`}>
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  heroImage={post.data.heroImage}
                  category={post.data.category}
                  tags={post.data.tags}
                  slug={post.slug}
                  featured={true}
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Categories Showcase -->
    <section class="py-20 relative">
      <div class="absolute inset-0 bg-gradient-to-br from-surface-50 to-primary-50/30 dark:from-gray-800/50 dark:to-primary-900/20"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 animate-slide-up">
          <h2 class="text-4xl md:text-5xl font-display font-bold text-gray-900 dark:text-gray-100 mb-4">Explore by Category</h2>
          <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">Dive deep into topics that matter to modern tech enthusiasts and families</p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {categories.map(category => {
            const categoryPosts = postsByCategory[category];
            const categoryInfo = {
              programming: { icon: '💻', title: 'Programming', desc: 'Code tutorials, best practices, and development insights' },
              automotive: { icon: '🚗', title: 'Automotive', desc: 'Car technology, reviews, and automotive innovations' },
              networking: { icon: '🌐', title: 'Networking', desc: 'Network configurations, protocols, and IT infrastructure' },
              tech: { icon: '⚡', title: 'Technology', desc: 'Latest tech trends, gadgets, and digital innovations' },
              family: { icon: '👨👩👧👦', title: 'Family Life', desc: 'Parenting tips, toddler experiences, and family adventures' }
            };
            
            return (
              <div class="group bg-white/80 dark:bg-gray-800/90 backdrop-blur-sm rounded-2xl shadow-glass border border-white/20 dark:border-gray-600/30 p-8 hover:shadow-glow hover:scale-105 transition-all duration-500">
                <div class="text-center mb-6">
                  <div class="text-5xl mb-4 group-hover:scale-110 transition-transform duration-300">{categoryInfo[category as keyof typeof categoryInfo].icon}</div>
                  <h3 class="text-2xl font-display font-bold text-gray-900 dark:text-gray-100 mb-3">
                    <a href={`/category/${category}`} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200">
                      {categoryInfo[category as keyof typeof categoryInfo].title}
                    </a>
                  </h3>
                  <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">{categoryInfo[category as keyof typeof categoryInfo].desc}</p>
                </div>
                
                {categoryPosts.length > 0 ? (
                  <div class="space-y-4">
                    {categoryPosts.map(post => (
                      <div class="bg-surface-50/50 dark:bg-gray-700/50 rounded-xl p-4 border-l-4 border-primary-400 dark:border-primary-500 hover:bg-primary-50/50 dark:hover:bg-primary-900/30 transition-colors duration-200">
                        <h4 class="font-semibold text-sm mb-1">
                          <a href={`/blog/${post.slug}`} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200 text-gray-900 dark:text-gray-100">
                            {post.data.title}
                          </a>
                        </h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400">{post.data.pubDate.toLocaleDateString()}</p>
                      </div>
                    ))}
                    <a href={`/category/${category}`} class="inline-flex items-center text-primary-600 dark:text-primary-400 text-sm font-semibold hover:text-primary-700 dark:hover:text-primary-300 group transition-colors duration-200">
                      View all {categoryInfo[category as keyof typeof categoryInfo].title.toLowerCase()} posts
                      <svg class="ml-1 h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </a>
                  </div>
                ) : (
                  <div class="text-center py-8">
                    <div class="text-3xl mb-2 opacity-50">✨</div>
                    <p class="text-gray-500 dark:text-gray-400 text-sm">Coming soon...</p>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Recent Posts -->
    <section class="py-20 relative">
      <div class="absolute inset-0 bg-gradient-to-b from-white to-surface-50/50 dark:from-gray-900 dark:to-gray-800/50"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center mb-16 animate-slide-up">
          <div>
            <h2 class="text-4xl md:text-5xl font-display font-bold text-gray-900 dark:text-gray-100 mb-2">Recent Posts</h2>
            <p class="text-xl text-gray-600 dark:text-gray-300">Fresh insights and discoveries</p>
          </div>
          <a href="/blog" class="group inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-semibold text-lg mt-4 md:mt-0 transition-colors duration-200">
            View all posts
            <svg class="ml-2 h-5 w-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {recentPosts.slice(1, 7).map((post, index) => (
            <div class="animate-fade-in" style={`animation-delay: ${index * 0.1}s;`}>
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                heroImage={post.data.heroImage}
                category={post.data.category}
                tags={post.data.tags}
                slug={post.slug}
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Newsletter Signup -->
    <section class="py-20 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary-600 via-primary-700 to-accent-600 dark:from-primary-700 dark:via-primary-800 dark:to-accent-700"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.1),transparent_50%)]"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="animate-fade-in">
          <h2 class="text-4xl md:text-5xl font-display font-bold text-white mb-6">Stay Updated</h2>
          <p class="text-primary-100 dark:text-primary-200 mb-12 text-xl leading-relaxed max-w-2xl mx-auto">
            Get the latest posts on programming, tech, cars, and family life delivered to your inbox.
          </p>
        </div>
        
        <div class="max-w-lg mx-auto animate-slide-up">
          <form class="flex flex-col sm:flex-row gap-4">
            <input 
              type="email" 
              placeholder="Enter your email"
              class="flex-1 px-6 py-4 rounded-2xl border-0 bg-white/90 dark:bg-gray-800/90 backdrop-blur-sm focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-600 focus:bg-white dark:focus:bg-gray-800 transition-all duration-200 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400"
              required
            />
            <button 
              type="submit"
              class="group bg-white dark:bg-gray-100 text-primary-600 dark:text-primary-700 px-8 py-4 rounded-2xl font-bold hover:bg-surface-50 dark:hover:bg-gray-200 hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl flex items-center justify-center"
            >
              Subscribe
              <svg class="ml-2 h-5 w-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
              </svg>
            </button>
          </form>
          <p class="text-primary-200 dark:text-primary-300 text-sm mt-4">No spam, unsubscribe anytime. ✨</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="relative bg-gradient-to-br from-surface-900 via-gray-900 to-surface-800 text-white py-16">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(14,165,233,0.1),transparent_70%)]"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-4 gap-12">
        <div class="md:col-span-2">
          <h3 class="text-3xl font-display font-bold mb-6 bg-gradient-to-r from-white to-primary-200 bg-clip-text text-transparent">RNZ Blog</h3>
          <p class="text-gray-300 mb-6 leading-relaxed text-lg">
            Sharing insights on programming, automotive technology, networking, and the adventures of raising a toddler.
          </p>
          <div class="flex space-x-6">
            <a href="#" class="group text-gray-400 hover:text-primary-400 transition-all duration-200 hover:scale-110">
              <span class="sr-only">Twitter</span>
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
              </svg>
            </a>
            <a href="#" class="group text-gray-400 hover:text-primary-400 transition-all duration-200 hover:scale-110">
              <span class="sr-only">LinkedIn</span>
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
              </svg>
            </a>
            <a href="#" class="group text-gray-400 hover:text-primary-400 transition-all duration-200 hover:scale-110">
              <span class="sr-only">GitHub</span>
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
              </svg>
            </a>
          </div>
        </div>
        
        <div>
          <h4 class="font-display font-semibold mb-6 text-xl">Categories</h4>
          <ul class="space-y-3 text-gray-300">
            {categories.map(category => (
              <li>
                <a href={`/category/${category}`} class="hover:text-primary-400 transition-colors duration-200 capitalize flex items-center group">
                  <span class="group-hover:translate-x-1 transition-transform duration-200">{category}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        
        <div>
          <h4 class="font-display font-semibold mb-6 text-xl">Quick Links</h4>
          <ul class="space-y-3 text-gray-300">
            <li><a href="/about" class="hover:text-primary-400 transition-colors duration-200 group flex items-center"><span class="group-hover:translate-x-1 transition-transform duration-200">About</span></a></li>
            <li><a href="/blog" class="hover:text-primary-400 transition-colors duration-200 group flex items-center"><span class="group-hover:translate-x-1 transition-transform duration-200">All Posts</span></a></li>
            <li><a href="/rss.xml" class="hover:text-primary-400 transition-colors duration-200 group flex items-center"><span class="group-hover:translate-x-1 transition-transform duration-200">RSS Feed</span></a></li>
          </ul>
        </div>
      </div>
      
      <div class="border-t border-gray-700/50 mt-12 pt-8 text-center">
        <p class="text-gray-400 text-lg">&copy; 2024 RNZ Blog. All rights reserved. Made with ❤️ and ☕</p>
      </div>
    </div>
  </footer>
</BaseLayout>