---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ReadingTime from '../components/ReadingTime.astro';
import ViewCounter from '../components/ViewCounter.astro';
import SocialShare from '../components/SocialShare.astro';
import Comments from '../components/Comments.astro';
import Analytics from '../components/Analytics.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import TouchGestures from '../components/TouchGestures.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, tags } = Astro.props;

// Breadcrumb items
const breadcrumbItems = [
  { label: 'Blog', href: '/blog' },
  { label: category, href: `/category/${category}` },
  { label: title }
];

// Mock headings for TOC (you can extract these from markdown if needed)
const headings = [
  { depth: 2, slug: 'introduction', text: 'Introduction' },
  { depth: 2, slug: 'main-content', text: 'Main Content' },
  { depth: 3, slug: 'subsection', text: 'Subsection' }
];

// Category colors for visual distinction
const categoryColors = {
  programming: 'bg-blue-100 text-blue-800',
  automotive: 'bg-red-100 text-red-800',
  networking: 'bg-green-100 text-green-800',
  tech: 'bg-purple-100 text-purple-800',
  family: 'bg-pink-100 text-pink-800'
};

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<BaseLayout 
  title={title} 
  description={description} 
  image={heroImage}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
  tags={tags}
>
  <Navigation />
  <ThemeToggle />
  <ReadingProgress />
  <Analytics />
  <ScrollToTop />
  <TouchGestures />
  
  <main class="pt-24 mt-8 bg-white dark:bg-gray-900 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Content -->
        <article class="flex-1 max-w-4xl">
          <!-- Breadcrumb -->
          <Breadcrumb items={breadcrumbItems} />

          <!-- Article Header -->
          <header class="mb-8">
            <div class="flex items-center gap-3 mb-4">
              <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${categoryColors[category as keyof typeof categoryColors]} dark:bg-opacity-20 dark:text-white`}>
                {category}
              </span>
              <time class="text-gray-500 dark:text-gray-300" datetime={pubDate.toISOString()}>
                {formatDate(pubDate)}
              </time>
              <ReadingTime content={description} />
              <ViewCounter slug={Astro.params.slug || 'unknown'} />
              {updatedDate && (
                <span class="text-gray-500 dark:text-gray-300 text-sm">
                  (Updated: {formatDate(updatedDate)})
                </span>
              )}
            </div>
            
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
              {title}
            </h1>
            
            <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
              {description}
            </p>

            {tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-6">
                {tags.map(tag => (
                  <span class="inline-block bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 text-sm px-3 py-1 rounded-full">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </header>

          <!-- Hero Image -->
          {heroImage && (
            <div class="mb-8 rounded-lg overflow-hidden shadow-lg">
              <img 
                src={heroImage} 
                alt={title}
                class="w-full h-64 md:h-96 object-cover"
              />
            </div>
          )}

          <!-- Article Content -->
          <div class="prose prose-lg max-w-none dark:prose-invert">
            <slot />
          </div>
          
          <!-- Social Share -->
          <SocialShare 
            title={title}
            description={description}
            url={Astro.url.toString()}
            image={heroImage}
          />

          <!-- Article Footer -->
          <footer class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <span class="text-gray-600 dark:text-gray-300">Share this post:</span>
                <div class="flex gap-2">
                  <a 
                    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.toString())}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-blue-500 text-white px-3 py-2 rounded text-sm hover:bg-blue-600 transition-colors"
                  >
                    Twitter
                  </a>
                  <a 
                    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.toString())}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-blue-700 text-white px-3 py-2 rounded text-sm hover:bg-blue-800 transition-colors"
                  >
                    LinkedIn
                  </a>
                </div>
              </div>
              
              <div class="flex gap-4">
                <a href="/blog" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium">
                  ← Back to Blog
                </a>
              </div>
            </div>
          </footer>

          <!-- Comments Section -->
          <Comments slug={Astro.params.slug || 'unknown'} />
        </article>
        
        <!-- Sidebar -->
        <aside class="lg:w-80 space-y-6">
          <TableOfContents headings={headings} />
        </aside>
      </div>
      
      <!-- Related Posts -->
      <RelatedPosts 
        currentSlug={Astro.params.slug || ''}
        category={category}
        tags={tags}
      />
    </div>

    <!-- Related Posts Section -->
    <section class="mt-16 bg-gray-50 dark:bg-gray-800 py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 text-center">Related Posts</h2>
        <div id="related-posts" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Related posts will be populated by JavaScript -->
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Custom prose styles for better readability */
  .prose {
    @apply text-gray-800 dark:text-gray-200 leading-relaxed;
  }
  
  .prose h2 {
    @apply text-2xl font-bold text-gray-900 dark:text-white mt-8 mb-4;
  }
  
  .prose h3 {
    @apply text-xl font-semibold text-gray-900 dark:text-white mt-6 mb-3;
  }
  
  .prose p {
    @apply mb-4 text-gray-700 dark:text-gray-300;
  }
  
  .prose a {
    @apply text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 underline;
  }
  
  .prose code {
    @apply bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 px-2 py-1 rounded text-sm;
  }
  
  .prose pre {
    @apply bg-gray-900 dark:bg-gray-800 text-gray-100 dark:text-gray-200 p-4 rounded-lg overflow-x-auto mb-4;
  }
  
  .prose pre code {
    @apply bg-transparent text-gray-100 dark:text-gray-200 p-0;
  }
  
  .prose blockquote {
    @apply border-l-4 border-blue-500 dark:border-blue-400 pl-4 italic text-gray-700 dark:text-gray-300 my-4;
  }
  
  .prose ul, .prose ol {
    @apply mb-4 pl-6;
  }
  
  .prose li {
    @apply mb-2 text-gray-700 dark:text-gray-300;
  }
  
  .prose img {
    @apply rounded-lg shadow-md my-6;
  }
</style>