---
import { SEO } from 'astro-seo';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}

const { 
  title, 
  description, 
  image = '/og-image.jpg', 
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = []
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0ea5e9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preload fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Enhanced SEO with astro-seo -->
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: new URL(image, Astro.url).toString(),
          url: Astro.url.toString()
        },
        optional: {
          description: description,
          siteName: 'RNZ Blog',
          locale: 'en_US'
        },
        image: {
          url: new URL(image, Astro.url).toString(),
          width: 1200,
          height: 630,
          alt: title
        },
        article: type === 'article' ? {
          publishedTime: publishedTime,
          modifiedTime: modifiedTime,
          authors: ['RNZ'],
          tags: tags
        } : undefined
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@rnzblog',
        creator: '@rnzblog',
        title: title,
        description: description,
        image: new URL(image, Astro.url).toString(),
        imageAlt: title
      }}
      extend={{
        meta: [
          { name: 'robots', content: 'index, follow' },
          { name: 'author', content: 'RNZ Blog' },
          { name: 'keywords', content: tags.join(', ') }
        ]
      }}
    />
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "RNZ Blog",
      "description": "Personal blog covering programming, automotive technology, networking, and family life",
      "url": "https://your-domain.com",
      "author": {
        "@type": "Person",
        "name": "RNZ"
      }
    }
    </script>
  </head>
  <body class="bg-gradient-to-br from-surface-50 via-white to-primary-50/30 dark:from-dark-50 dark:via-dark-100 dark:to-dark-200 text-gray-900 dark:text-gray-100 font-sans antialiased transition-colors duration-300">
    <div class="min-h-screen backdrop-blur-3xl">
      <slot />
    </div>
  </body>
</html>