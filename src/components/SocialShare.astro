---
// Social sharing component with auto-posting capabilities
interface Props {
  title: string;
  description: string;
  url: string;
  image?: string;
}

const { title, description, url, image } = Astro.props;

const encodedTitle = encodeURIComponent(title);
const encodedDescription = encodeURIComponent(description);
const encodedUrl = encodeURIComponent(url);
const encodedImage = image ? encodeURIComponent(image) : '';
---

<div class="social-share flex items-center gap-3 py-4">
  <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Share:</span>
  
  <!-- Twitter/X -->
  <a 
    href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    class="group p-2 bg-gray-100 dark:bg-gray-800 hover:bg-blue-500 rounded-xl transition-all duration-200 hover:scale-110"
    title="Share on Twitter"
    onclick="trackShare('twitter')"
  >
    <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 group-hover:text-white" fill="currentColor" viewBox="0 0 24 24">
      <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
    </svg>
  </a>
  
  <!-- LinkedIn -->
  <a 
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    class="group p-2 bg-gray-100 dark:bg-gray-800 hover:bg-blue-700 rounded-xl transition-all duration-200 hover:scale-110"
    title="Share on LinkedIn"
    onclick="trackShare('linkedin')"
  >
    <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 group-hover:text-white" fill="currentColor" viewBox="0 0 24 24">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
    </svg>
  </a>
  
  <!-- Facebook -->
  <a 
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    class="group p-2 bg-gray-100 dark:bg-gray-800 hover:bg-blue-600 rounded-xl transition-all duration-200 hover:scale-110"
    title="Share on Facebook"
    onclick="trackShare('facebook')"
  >
    <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 group-hover:text-white" fill="currentColor" viewBox="0 0 24 24">
      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
    </svg>
  </a>
  
  <!-- Copy Link -->
  <button 
    onclick="copyToClipboard()"
    class="group p-2 bg-gray-100 dark:bg-gray-800 hover:bg-green-500 rounded-xl transition-all duration-200 hover:scale-110"
    title="Copy link"
    id="copy-button"
  >
    <svg class="w-5 h-5 text-gray-600 dark:text-gray-400 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
    </svg>
  </button>
</div>

<script define:vars={{ url, title }}>
  function trackShare(platform: string) {
    if (typeof (window as any).trackEvent === 'function') {
      (window as any).trackEvent('social_share', {
        platform: platform,
        url: url,
        title: title
      });
    }
  }
  
  async function copyToClipboard() {
    try {
      await navigator.clipboard.writeText(url);
      
      const button = document.getElementById('copy-button');
      if (button) {
        const originalHTML = button.innerHTML;
        button.innerHTML = `
          <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        `;
        
        setTimeout(() => {
          button.innerHTML = originalHTML;
        }, 2000);
      }
      
      trackShare('copy_link');
    } catch (err) {
      console.error('Failed to copy: ', err);
    }
  }
  
  // Make functions globally available
  (window as any).trackShare = trackShare;
  (window as any).copyToClipboard = copyToClipboard;
</script>