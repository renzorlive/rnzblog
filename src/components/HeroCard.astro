---
// Hero card component for sidebar
---

<div class="bg-gradient-to-br from-primary-500/10 via-accent-500/5 to-primary-600/10 dark:from-primary-400/20 dark:via-accent-400/10 dark:to-primary-500/20 backdrop-blur-sm rounded-2xl shadow-glass border border-white/20 dark:border-gray-600/30 p-6 mb-6">
  <div class="text-center">
    <div class="mb-4">
      <h2 class="text-2xl font-display font-bold mb-3 bg-gradient-to-r from-gray-900 via-primary-600 to-accent-600 dark:from-gray-100 dark:via-primary-400 dark:to-accent-400 bg-clip-text text-transparent">
        Welcome to RNZ Blog
      </h2>
      <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm">
        Exploring the intersection of <span class="font-semibold text-primary-600 dark:text-primary-400">technology</span>, 
        <span class="font-semibold text-accent-600 dark:text-accent-400">automotive innovation</span>, and 
        <span class="font-semibold text-primary-700 dark:text-primary-300">family life</span>.
      </p>
    </div>
    
    <div class="flex justify-center space-x-4 text-2xl mb-4 animate-float">
      <span class="opacity-60">💻</span>
      <span class="opacity-60" style="animation-delay: 0.5s;">🚗</span>
      <span class="opacity-60" style="animation-delay: 1s;">🌐</span>
      <span class="opacity-60" style="animation-delay: 1.5s;">👨‍👩‍👧‍👦</span>
    </div>
    
    <div class="flex flex-col gap-2">
      <a href="/about" class="group bg-white/70 dark:bg-gray-700/70 backdrop-blur-sm border border-primary-200 dark:border-primary-600 text-primary-700 dark:text-primary-300 px-4 py-2 rounded-xl text-sm font-semibold hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:border-primary-300 dark:hover:border-primary-500 hover:scale-105 transition-all duration-300">
        About Me
      </a>
    </div>
  </div>
</div>